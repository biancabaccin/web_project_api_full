# http://editorconfig.org

# A special property that should be specified at the top of the file.
# When set to true, it prevents EditorConfig from searching for any values higher
# in the directory tree for .editorconfig files.
root = true

[*]
# Indentation style
# Possible values - tab, space
indent_style = space

# Indentation size in single-space characters
# Possible values - an integer, tab
indent_size = 2

# Newline characters to use (varies depending on the operating system)
# Possible values - lf, crlf, cr
end_of_line = lf

# Character encoding for files
# Possible values - latin1, utf-8, utf-16be, utf-16le
charset = utf-8

# Indicates whether trailing whitespace should be removed
# Possible values - true, false
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Indicates whether the file should end with a newline
# Possible values - true, false
insert_final_newline = true
